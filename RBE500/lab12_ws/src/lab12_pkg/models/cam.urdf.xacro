<?xml version="1.0" ?>
<robot name="cam" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="PI" value="3.1416" />
  <link name="world"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1" />
      <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3" />
    </inertial>
  </link>
  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="2 4 0.5" rpy="0 0 -${PI/2}"/>
  </joint>
  <gazebo reference="base_link">
    <sensor type="camera" name="gz_camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>8</update_rate>
      <visualize>true</visualize>
      <topic>model_camera/image_raw</topic>
    </sensor>
  </gazebo>
</robot>